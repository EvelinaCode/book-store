generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  category    String
  price       Float
  stock       Int
  description String?
  isbn        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}